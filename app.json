{
  "expo": {
    "name": "Expense Tracker",
    "slug": "ExpenseTracker",
    "version": "1.1.0",
    "icon": "./assets/images/expense-tracker-app-icon.png",
    "orientation": "portrait",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/expense-tracker-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#EEF2FF",
          "dark": {
            "backgroundColor": "#111827"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "onnxruntime-react-native",
      "expo-image",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b8982fe-7dc4-4150-b51d-5355bd0b5f1d"
      }
    },
    "android": {
      "package": "com.expensetracker.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/expense-tracker-adaptive-foreground.png",
        "backgroundColor": "#4F46E5"
      }
    }
  }
}
